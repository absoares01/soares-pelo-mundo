# ---------- Supabase (login e banco de dados) ----------
# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor. NUNCA coloque este valor em NEXT_PUBLIC_*.
# Necessária para o cliente abrir a proposta pelo link (/p/...) e aceitar ou recusar.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: só estes e-mails conseguem entrar (separados por vírgula). Vazio = qualquer pessoa que se cadastrar.
ALLOWED_EMAILS=
