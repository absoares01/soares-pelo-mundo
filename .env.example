# ---------- SerpApi (dados de voos do Google Flights) ----------
# Crie a chave em https://serpapi.com/manage-api-key
# Sem esta chave o app roda em MODO EXEMPLO (dados fictícios, sempre identificados na tela).
SERPAPI_KEY=

# ---------- Supabase (login, clientes, histórico, propostas) ----------
# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor. NUNCA coloque este valor em NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: só estes e-mails entram no app (separados por vírgula). Vazio = qualquer usuário do Supabase.
ALLOWED_EMAILS=

# ---------- IA opcional (resumo em linguagem natural) ----------
# Se vazio, o botão de resumo por IA fica oculto. Os números nunca vêm da IA.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Alertas de preço por e-mail ----------
# Chave do Resend (https://resend.com/api-keys). Sem ela, os alertas são verificados mas nenhum e-mail sai.
RESEND_API_KEY=
# Remetente. Padrão "Soares pelo Mundo <onboarding@resend.dev>" só entrega ao e-mail da sua conta Resend;
# para enviar a outros destinatários, verifique um domínio seu no Resend e use ex.: "Soares pelo Mundo <alertas@seudominio.com>".
ALERT_FROM_EMAIL=
# Senha da rotina diária (invente um texto longo e aleatório). Sem ela a verificação automática fica desligada.
CRON_SECRET=
# Máximo de alertas verificados por execução (cada um usa 1 crédito da SerpApi)
ALERTS_MAX_PER_RUN=30
# Opcional: endereço público do app (usado nos links do e-mail). Ex.: https://seu-app.vercel.app
NEXT_PUBLIC_APP_URL=

# ---------- Ajustes ----------
# Limite de combinações de datas por busca (cada uma consome 1 crédito da SerpApi)
MAX_DATE_COMBOS=25
